# Base URL of the Teamcenter REST backend (required).
TEAMCENTER_API_URL=http://localhost:5000

# Timeout in seconds for calls to the Teamcenter backend.
TEAMCENTER_HTTP_TIMEOUT=60

# MCP server transport: http (Streamable HTTP, default) or stdio.
MCP_TRANSPORT=http
# 0.0.0.0 = reachable from other machines; 127.0.0.1 = this machine only.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

LOG_LEVEL=INFO
